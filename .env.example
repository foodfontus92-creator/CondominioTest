# PostgreSQL
POSTGRES_DB=accesolibre
POSTGRES_USER=accesolibre
POSTGRES_PASSWORD=accesolibre_local_dev
POSTGRES_PORT=5432

# Eclipse Mosquitto MQTT
MQTT_BACKEND_USER=accesolibre_backend
MQTT_BACKEND_PASSWORD=mqtt_backend_local_dev
MQTT_DEVICE_USER=accesolibre_device
MQTT_DEVICE_PASSWORD=mqtt_device_local_dev
MQTT_PORT=1883
MQTT_WS_PORT=9001

# Backend Spring Boot & CORS
SPRING_PROFILES_ACTIVE=local
BACKEND_PORT=8080
JWT_SECRET=9f86d081884c7d659a2feaa0c55ad015a3bf4f1b2b0b822cd15d6c15b0f00a08
CORS_ALLOWED_ORIGINS=https://accesolibre.fodtech.cl,http://192.168.1.10:3005,http://localhost:3005

# Web Admin (Vite Build + Nginx)
WEB_ADMIN_PORT=80
VITE_API_URL=https://api-accesolibre.fodtech.cl
